{
  "name": "@tehreer/web",
  "version": "0.1.0",
  "description": "Tehreer text engine for the web: Tehreer Core compiled to WebAssembly with a TypeScript API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tehreer/Tehreer-Web.git"
  },
  "homepage": "https://github.com/Tehreer/Tehreer-Web#readme",
  "bugs": "https://github.com/Tehreer/Tehreer-Web/issues",
  "keywords": [
    "text",
    "typography",
    "text-layout",
    "shaping",
    "bidi",
    "opentype",
    "webassembly",
    "arabic",
    "urdu"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "mcp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "tsc -p tests/tsconfig.json && node scripts/copy-wasm.mjs build/src/wasm && node --test \"build/tests/*.test.js\"",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "@tehreer/web": "file:."
  }
}
